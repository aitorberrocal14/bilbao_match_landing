# Staging output. The two packages people actually download — the site and
# the WordPress plugin — are committed instead of ignored: whoever publishes
# this site cannot install Node to rebuild them, so a copy they can download
# straight from the repository is worth more than a tidy history.
dist/_subir/
dist/web-de-prueba.zip

# El registro del sync, que lo escribe el servidor en cada ejecución.
server/sync.log
server/deploy.log
