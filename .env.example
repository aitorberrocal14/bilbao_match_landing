# CREDENCIALES DE LA PLATAFORMA — plantilla
# -----------------------------------------------------------------------------
# Copia este archivo como `.env` y rellena los valores:
#
#     cp .env.example .env
#
# `.env` está en .gitignore: no se sube al repositorio, no viaja al hosting y no
# aparece en el historial. Este archivo de ejemplo sí se versiona, así que
# NUNCA escribas aquí los valores reales — solo en `.env`.
#
# Lo usa tools/sync-exhibitors.js, que consulta la plataforma y actualiza la
# lista de expositores. La web publicada nunca llama a la API ni lleva la clave
# dentro: la consulta se hace aquí, al generar, y lo que se publica son los
# datos ya resueltos. Por eso la clave puede ser de solo lectura y nunca sale
# de este ordenador.

# El endpoint de la API de Meetmaps. Tampoco es una credencial: sin la clave no
# devuelve nada.
MBB_API_URL=https://apiv1.meetmaps.com/api/v1/

# La user_key que emite la plataforma.
#
#   · No la pegues en un chat, ni en un correo, ni en un documento compartido.
#   · Pídela de SOLO LECTURA: para mostrar expositores no hace falta más, y una
#     clave que solo lee no puede estropear nada si se filtra.
#   · Si alguna vez se ha compartido por descuido, pide que la regeneren.
MBB_API_KEY=

# El identificador del evento en la plataforma. El de MATCHBILBAOBIZKAIA2026
# es 15425 — no es una credencial, es un número de evento, así que se puede
# escribir tal cual.
MBB_EVENT_ID=15425
